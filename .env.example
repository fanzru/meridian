# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
# Select the provider object the code should use (alchemy | helius).
RPC_PROVIDER=alchemy
# Put the matching endpoint in RPC_URL.
RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here
# Optional separate RPC for the PnL poller.
# PNL_RPC_PROVIDER=helius
# PNL_RPC_URL=https://pump.helius-rpc.com

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=sk-or-...here

# Option B: Hermes Codex OAuth (requires local Hermes login)
# Run once: hermes auth add openai-codex
# HERMES_CODEX_AUTH=true
# LLM_MODEL=gpt-5.4

# Option C: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here
# Optional external-service keys (keep in .env only)
# LLM_API_KEY=your_openai_compatible_provider_key
# GMGN_API_KEY=your_gmgn_api_key
# HIVEMIND_API_KEY=your_private_hivemind_api_key
# PUBLIC_API_KEY=your_agent_meridian_public_api_key

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── External sync (disabled by default) ───────────────────────────────────────
HIVEMIND_ENABLED=false

# ── Optional Jupiter referral (disabled by default) ───────────────────────────
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=0

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=info
